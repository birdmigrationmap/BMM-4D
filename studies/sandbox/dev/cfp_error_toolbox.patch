+function gates = attach_cfp(gates, scan_file, limit_elev)
+% CFP code of every gate from the raw file (bmm4d.radar.read_level2_moments):
+% the cut with CFP (the surveillance pass of a split cut) closest in
+% elevation, the nearest radial and the gate at the same range. Gates
+% without a match get NaN.
+cuts = bmm4d.radar.read_level2_moments(scan_file, "CFP", limit_elev + 0.5);
+cuts = cuts(arrayfun(@(cut) ~isempty(cut.CFP), cuts));
+cut_elev = [cuts.elev];
+for i_elev = 1:numel(gates)
+    gates(i_elev).cfp_code = nan(size(gates(i_elev).data));
+    [gap, k] = min(abs(cut_elev - gates(i_elev).elev));
+    if isempty(k) || gap > 0.2
+        continue
+    end
+    cut = cuts(k);
+    code = double(cut.CFP_code);
+    % Nearest radial (circular) and gate
+    az_cut = double(cut.az(:));
+    [az_sorted, order] = sort(az_cut);
+    az_ext = [az_sorted(end) - 360; az_sorted; az_sorted(1) + 360];
+    order_ext = [order(end); order; order(1)];
+    az_id = order_ext(interp1(az_ext, 1:numel(az_ext), double(gates(i_elev).az(:)), "nearest"));
+    range_cut = double(cut.CFP_range(:));
+    range_id = interp1(range_cut, 1:numel(range_cut), double(gates(i_elev).range(:)), "nearest");
+    in_range = ~isnan(range_id) & abs(range_cut(max(range_id, 1)) - double(gates(i_elev).range(:))) < 0.5 * median(diff(range_cut));
+    gates(i_elev).cfp_code(in_range, :) = code(range_id(in_range), az_id);
+end
+end
